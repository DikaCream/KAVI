[TEMPLATE]
# GenLayer RPC API URL (defaults to StudioNet)
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# GenLayer network: studionet | testnet-asimov | localnet
VITE_GENLAYER_NETWORK=studionet

# KAVI contract address. Optional: config.ts falls back to the live
# StudioNet deployment when this is unset, so local/dev builds work too.
VITE_CONTRACT_ADDRESS=0x2A7f8995EAe909575787C14629ec924AE6D1ad7D
